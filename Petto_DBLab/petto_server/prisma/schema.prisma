datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model KhachHang {
  ma_kh              String             @id @db.Char(8)
  ho_ten             String             @db.VarChar(100)
  sdt                String             @unique @db.VarChar(15)
  email              String             @unique @db.VarChar(100)
  mat_khau           String             @db.VarChar(255)
  dia_chi            String?            @db.VarChar(255)
  ngay_tao_tai_khoan DateTime           @default(now()) @db.Timestamp(6)
  
  thu_cung           ThuCung[]
  vi_voucher         ViVoucher[]
  chi_tiet_gio_hang  ChiTietGioHang[]
  hoa_don            HoaDon[]
  dat_lich           DatLich[]
  don_hang           DonHang[]

  @@map("khach_hang")
}

model ThuCung {
  ma_thu_cung  String    @id @db.Char(8)
  ma_kh        String    @db.Char(8)
  ten_thu_cung String    @db.VarChar(50)
  loai         String    @db.VarChar(30)
  giong        String?   @db.VarChar(50)
  tuoi         Int?
  can_nang     Decimal   @db.Decimal(5, 2)
  ghi_chu      String?   @db.VarChar(255)

  khach_hang   KhachHang @relation(fields: [ma_kh], references: [ma_kh], onDelete: Cascade)
  dat_lich     DatLich[]

  @@map("thu_cung")
}

model NhanVien {
  ma_nv        String         @id @db.Char(8)
  ho_ten       String         @db.VarChar(100)
  sdt          String         @unique @db.VarChar(15)
  email        String         @unique @db.VarChar(100)
  mat_khau     String         @db.VarChar(255)
  vai_tro      String         @db.VarChar(20)
  trang_thai   String         @default("Dang lam") @db.VarChar(20)

  phan_cong_ca PhanCongCa[]
  hoa_don      HoaDon[]
  dat_lich     DatLich[]

  @@map("nhan_vien")
}

model CaLamViec {
  ma_ca        String         @id @db.Char(8)
  ten_ca       String         @unique @db.VarChar(50)
  gio_bat_dau  DateTime       @db.Time
  gio_ket_thuc DateTime       @db.Time
  trang_thai   String         @default("Hoat dong") @db.VarChar(20)

  phan_cong_ca PhanCongCa[]

  @@map("ca_lam_viec")
}

model PhanCongCa {
  ma_nv          String     @db.Char(8)
  ma_ca          String     @db.Char(8)
  ngay_lam_viec  DateTime   @db.Date

  nhan_vien      NhanVien   @relation(fields: [ma_nv], references: [ma_nv], onDelete: Cascade)
  ca_lam_viec    CaLamViec  @relation(fields: [ma_ca], references: [ma_ca], onDelete: Cascade)

  @@id([ma_nv, ma_ca, ngay_lam_viec])
  @@map("phan_cong_ca")
}

model DichVu {
  ma_dich_vu         String    @id @db.Char(8)
  ten_dich_vu        String    @unique @db.VarChar(100)
  mo_ta              String?   @db.VarChar(255)
  gia_tien           Decimal   @db.Decimal(12, 2)
  thoi_gian_uoc_tinh Int
  trang_thai         String    @default("Dang cung cap") @db.VarChar(30)

  dat_lich           DatLich[]

  @@map("dich_vu")
}

model SanPham {
  ma_sp             String            @id @db.Char(8)
  ten_sp            String            @unique @db.VarChar(100)
  mo_ta             String?           @db.VarChar(255)
  gia_ban           Decimal           @db.Decimal(12, 2)
  so_luong_ton      Int               @default(0)
  trang_thai        String            @default("Dang ban") @db.VarChar(20)

  chi_tiet_gio_hang ChiTietGioHang[]
  chi_tiet_don_hang ChiTietDonHang[]

  @@map("san_pham")
}

model Voucher {
  ma_voucher          String      @id @db.Char(8)
  loai_giam           String      @db.VarChar(20)
  gia_tri_giam        Decimal     @db.Decimal(12, 2)
  muc_giam_toi_da     Decimal?    @db.Decimal(12, 2)
  don_toi_thieu       Decimal     @default(0) @db.Decimal(12, 2)
  han_su_dung         DateTime    @db.Timestamp(6)
  dieu_kien_kich_hoat String?     @db.VarChar(255)

  vi_voucher          ViVoucher[]

  @@map("voucher")
}

model ViVoucher {
  ma_kh        String    @db.Char(8)
  ma_voucher   String    @db.Char(8)
  so_luot_con  Int       @default(1)

  khach_hang   KhachHang @relation(fields: [ma_kh], references: [ma_kh], onDelete: Cascade)
  voucher      Voucher   @relation(fields: [ma_voucher], references: [ma_voucher], onDelete: Cascade)

  dat_lich     DatLich[]
  don_hang     DonHang[]

  @@id([ma_kh, ma_voucher])
  @@map("vi_voucher")
}

model ChiTietGioHang {
  ma_kh      String    @db.Char(8)
  ma_sp      String    @db.Char(8)
  so_luong   Int

  khach_hang KhachHang @relation(fields: [ma_kh], references: [ma_kh], onDelete: Cascade)
  san_pham   SanPham   @relation(fields: [ma_sp], references: [ma_sp], onDelete: Cascade)

  @@id([ma_kh, ma_sp])
  @@map("chi_tiet_gio_hang")
}

model PhuongThucGiaoHang {
  ma_pt_giao  String    @id @db.Char(8)
  ten_pt_giao String    @unique @db.VarChar(50)

  don_hang    DonHang[]

  @@map("phuong_thuc_giao_hang")
}

model PhuongThucThanhToan {
  ma_pttt  String    @id @db.Char(8)
  ten_pttt String    @unique @db.VarChar(50)

  hoa_don  HoaDon[]

  @@map("phuong_thuc_thanh_toan")
}

model HoaDon {
  ma_hoa_don      String              @id @db.Char(8)
  ma_kh           String              @db.Char(8)
  ma_nv_thu_ngan  String?             @db.Char(8)
  ma_pttt         String              @db.Char(8)
  tong_tien       Decimal             @db.Decimal(12, 2)
  ngay_thanh_toan DateTime?           @db.Timestamp(6)

  khach_hang      KhachHang           @relation(fields: [ma_kh], references: [ma_kh])
  nhan_vien       NhanVien?           @relation(fields: [ma_nv_thu_ngan], references: [ma_nv])
  thanh_toan      PhuongThucThanhToan @relation(fields: [ma_pttt], references: [ma_pttt])

  dat_lich        DatLich[]
  don_hang        DonHang[]

  @@map("hoa_don")
}

model DatLich {
  ma_dat_lich        String     @id @db.Char(8)
  ma_kh              String     @db.Char(8)
  ma_thu_cung        String     @db.Char(8)
  ma_dich_vu         String     @db.Char(8)
  ma_nv_phu_trach    String?    @db.Char(8)
  ma_voucher         String?    @db.Char(8)
  ma_hoa_don         String?    @db.Char(8)
  ngay_hen           DateTime   @db.Date
  gio_hen            DateTime   @db.Time
  hinh_thuc_dua_don  String     @db.VarChar(30)
  dia_chi_dua_don    String?    @db.VarChar(255)
  phi_dua_don        Decimal    @default(0) @db.Decimal(12, 2)
  gia_dich_vu_chot   Decimal    @db.Decimal(12, 2)
  thanh_tien         Decimal    @db.Decimal(12, 2)
  trang_thai         String     @default("Cho xac nhan") @db.VarChar(30)
  ly_do_huy          String?    @db.VarChar(255)

  khach_hang         KhachHang  @relation(fields: [ma_kh], references: [ma_kh])
  thu_cung           ThuCung    @relation(fields: [ma_thu_cung], references: [ma_thu_cung])
  dich_vu            DichVu     @relation(fields: [ma_dich_vu], references: [ma_dich_vu])
  nhan_vien          NhanVien?  @relation(fields: [ma_nv_phu_trach], references: [ma_nv])
  hoa_don            HoaDon?    @relation(fields: [ma_hoa_don], references: [ma_hoa_don])
  
  // Custom composite FK to ViVoucher
  vi_voucher         ViVoucher? @relation(fields: [ma_kh, ma_voucher], references: [ma_kh, ma_voucher])

  don_hang           DonHang[]

  @@map("dat_lich")
}

model DonHang {
  ma_don_hang       String             @id @db.Char(8)
  ma_kh             String             @db.Char(8)
  ma_pt_giao        String             @db.Char(8)
  ma_dat_lich       String?            @db.Char(8)
  ma_voucher        String?            @db.Char(8)
  ma_hoa_don        String?            @db.Char(8)
  ngay_dat          DateTime           @default(now()) @db.Timestamp(6)
  ten_nguoi_nhan    String             @db.VarChar(100)
  sdt_nguoi_nhan    String             @db.VarChar(15)
  dia_chi_nhan      String             @db.VarChar(255)
  phi_van_chuyen    Decimal            @default(0) @db.Decimal(12, 2)
  thanh_tien        Decimal            @db.Decimal(12, 2)
  trang_thai        String             @default("Cho xu ly") @db.VarChar(30)
  ly_do_huy         String?            @db.VarChar(255)

  khach_hang        KhachHang          @relation(fields: [ma_kh], references: [ma_kh])
  giao_hang         PhuongThucGiaoHang @relation(fields: [ma_pt_giao], references: [ma_pt_giao])
  dat_lich          DatLich?           @relation(fields: [ma_dat_lich], references: [ma_dat_lich])
  hoa_don           HoaDon?            @relation(fields: [ma_hoa_don], references: [ma_hoa_don])
  
  // Custom composite FK to ViVoucher
  vi_voucher        ViVoucher?         @relation(fields: [ma_kh, ma_voucher], references: [ma_kh, ma_voucher])

  chi_tiet_don_hang ChiTietDonHang[]

  @@map("don_hang")
}

model ChiTietDonHang {
  ma_don_hang  String   @db.Char(8)
  ma_sp        String   @db.Char(8)
  so_luong     Int
  gia_ban      Decimal  @db.Decimal(12, 2)

  don_hang     DonHang  @relation(fields: [ma_don_hang], references: [ma_don_hang], onDelete: Cascade)
  san_pham     SanPham  @relation(fields: [ma_sp], references: [ma_sp])

  @@id([ma_don_hang, ma_sp])
  @@map("chi_tiet_don_hang")
}
